# Copie para .env e informe valores somente no ambiente local/deploy.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-secret-key
# Compatibilidade temporaria; prefira SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional para migrações/testes PostgreSQL diretos. Nunca versione credenciais.
DATABASE_URL=
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
PNCP_BASE_URL=https://pncp.gov.br/api/consulta/v1
OPEN_CNPJ_BASE_URL=https://api.opencnpj.org
IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v1/localidades
EXTERNAL_API_MAX_RETRIES=2
PNCP_CACHE_TTL_SECONDS=300
IBGE_CACHE_TTL_SECONDS=86400
OPEN_CNPJ_CACHE_TTL_SECONDS=21600
PNCP_SCRAPE_USER_AGENT=LicitaAI/0.1 (+https://github.com/Raulsakata/licita_ai)
# Variações identificáveis do mesmo coletor; a rotação não substitui limites ou controles do portal.
PNCP_SCRAPE_USER_AGENT_POOL=LicitaAI/0.1 (+https://github.com/Raulsakata/licita_ai; channel=sync)|LicitaAI/0.1 (+https://github.com/Raulsakata/licita_ai; channel=scrape)
PNCP_SCRAPE_TIMEOUT_SECONDS=20
PNCP_SCRAPE_BATCH_SIZE=10
PNCP_SCRAPE_MIN_INTERVAL_SECONDS=1
PNCP_SCRAPE_POLL_SECONDS=30
PNCP_SCRAPE_REFRESH_SECONDS=39600

# Somente chave publicavel no frontend, se um recurso cliente realmente precisar.
# VITE_API_URL=http://localhost:3000
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Autenticacao (gere o hash com: python -c "from src.auth import hash_password; print(hash_password('SUA_SENHA'))")
AUTH_SECRET=
ADMIN_USER=
ADMIN_PASSWORD_HASH=
PNCP_SYNC_SECRET=
