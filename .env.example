SUPABASE_PUBLISHABLE_KEY=sb_publishable_1QE_w1IHYlo4HF_NZ0WDhQ_SeCPeMWR
SUPABASE_SECRET_KEY=sb_secret_substitua_pela_chave_secreta
SUPABASE_JWKS_URL=https://aoiwerrhjotegrgzkpzu.supabase.co/auth/v1/.well-known/jwks.json
# Compatibilidade com o cliente atual da API até a migração para SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=preencha-apenas-no-backend
# Alternativa para migrações e testes PostgreSQL diretos. Nunca versione a senha.
# Substitua [YOUR-PASSWORD] pela senha do banco. Se a senha tiver caracteres
# especiais, faça percent-encoding (ex.: "@" -> "%40", "#" -> "%23").
# O usuário do pooler é "postgres.aoiwerrhjotegrgzkpzu" (projeto + referência).
DATABASE_URL=postgresql://postgres.aoiwerrhjotegrgzkpzu:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
PNCP_BASE_URL=https://pncp.gov.br/api/consulta/v1
OPEN_CNPJ_BASE_URL=https://api.opencnpj.org
